	/// Primeiro dia do mês: use nos visuais Deneb mensais para receber uma linha por mês.
	column 'Início do Mês' = DATE ( YEAR ( D_Calendario[Data] ), MONTH ( D_Calendario[Data] ), 1 )
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: 5463bba9-02d3-490d-9df2-8da0b99d7745
		summarizeBy: none

	partition D_Calendario = calculated
		mode: import
		source =
				
				VAR _Inicio = DATE ( YEAR ( MIN ( F_Vendas[Data_Pedido] ) ), 1, 1 )
				VAR _Fim    = DATE ( YEAR ( MAX ( F_Vendas[Data_Entrega] ) ), 12, 31 )
				RETURN
				ADDCOLUMNS (
				    CALENDAR ( _Inicio, _Fim ),
				    "Ano", YEAR ( [Date] ),
				    "Mês Número", MONTH ( [Date] ),
				    "Mês", FORMAT ( [Date], "mmmm" ),
				    "Mês Abrev", FORMAT ( [Date], "mmm" ),
				    "Ano Mês", FORMAT ( [Date], "mmm/yy" ),
				    "Ano Mês Número", YEAR ( [Date] ) * 100 + MONTH ( [Date] ),
				    "Trimestre", "T" & QUARTER ( [Date] ),
				    "Dia da Semana", FORMAT ( [Date], "dddd" ),
				    "Dia da Semana Número", WEEKDAY ( [Date], 2 ),
				    "Fim de Semana", IF ( WEEKDAY ( [Date], 2 ) > 5, "Sim", "Não" )
				)

	annotation PBI_Id = ee7ae19ff70d4b5eadabb786154c9563

