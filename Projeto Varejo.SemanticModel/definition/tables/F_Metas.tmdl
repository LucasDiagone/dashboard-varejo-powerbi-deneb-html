table F_Metas
	lineageTag: f17e2f9a-6962-43d7-aef7-13f856d2b150

	column Mes_Referencia
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: 91767f7a-705e-4cbb-a2b4-c73a6405661a
		summarizeBy: none
		sourceColumn: Mes_Referencia

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	column ID_Loja
		dataType: string
		isHidden
		lineageTag: 6c4840e2-d193-4507-a3e7-16a4887b6081
		summarizeBy: none
		sourceColumn: ID_Loja

		annotation SummarizationSetBy = Automatic

	column Meta_Faturamento
		dataType: int64
		formatString: \R$ #,0
		lineageTag: 46596440-d9ce-40c9-bf69-6876a1e2f6ab
		summarizeBy: sum
		sourceColumn: Meta_Faturamento

		annotation SummarizationSetBy = Automatic

	partition F_Metas = m
		mode: import
		queryGroup: Fato
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaDados & "metas_mensais_lojas.csv"),[Delimiter=";", Columns=3, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				    #"Cabeçalhos Promovidos" = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(#"Cabeçalhos Promovidos",{{"Mes_Referencia", type date}, {"ID_Loja", type text}, {"Meta_Faturamento", Int64.Type}})
				in
				    #"Tipo Alterado"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegação

