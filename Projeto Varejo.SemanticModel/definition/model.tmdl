model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Dimensão

	annotation PBI_QueryGroupOrder = 0

queryGroup Fato

	annotation PBI_QueryGroupOrder = 1

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["F_Metas","Base_Vendas","F_Vendas","D_Clientes","D_Produto","D_Loja","D_Vendedor","D_Canal_Venda","D_Forma_Pagamento","D_Status_Pedido"]

annotation PBI_ProTooling = ["DevMode","MCP-PBIModeling"]

ref table F_Metas
ref table D_Clientes
ref table D_Produto
ref table D_Loja
ref table D_Vendedor
ref table D_Canal_Venda
ref table D_Forma_Pagamento
ref table D_Status_Pedido
ref table F_Vendas
ref table D_Calendario
ref table _Medidas

ref cultureInfo pt-BR

